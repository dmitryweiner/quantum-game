{
  "name": "quantum-game",
  "version": "0.0.1",
  "private": true,
  "description": "A web puzzle game about the weirdness of the quantum world",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
